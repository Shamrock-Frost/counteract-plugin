<div class="counteract-body">
  {{!-- Mode toggle --}}
  <fieldset class="mode-toggle">
    <legend>{{localize "COUNTERACT.ModeSelect.Title"}}</legend>
    <label class="{{#unless isCounterspell}}active{{/unless}}">
      <input type="radio" name="mode" value="dispel" {{#unless isCounterspell}}checked{{/unless}}>
      <i class="fa-solid fa-wand-magic-sparkles" inert></i> {{localize "COUNTERACT.ModeSelect.DispelEffect"}}
    </label>
    <label class="{{#if isCounterspell}}active{{/if}}">
      <input type="radio" name="mode" value="counterspell" {{#if isCounterspell}}checked{{/if}}>
      <i class="fa-solid fa-shield-halved" inert></i> {{localize "COUNTERACT.ModeSelect.Counterspell"}}
    </label>
  </fieldset>

  {{!-- Source --}}
  <section class="side">
    <header class="side-header">
      {{#if actor}}<img src="{{actor.img}}" alt="">{{else}}<i class="fa-solid fa-user" inert></i>{{/if}}
      <h3>{{localize "COUNTERACT.Dialog.SourceSection"}}</h3>
    </header>

    <div class="form-group">
      <label for="counteract-actor">{{localize "COUNTERACT.Dialog.Actor"}}</label>
      <select name="actorUuid" id="counteract-actor">
        <option value="">{{localize "COUNTERACT.Dialog.SelectActor"}}</option>
        {{#each actors}}
          <option value="{{uuid}}" {{#if (eq uuid ../actorUuid)}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label for="counteract-spell">{{localize "COUNTERACT.Dialog.Spell"}}</label>
      <select name="spellId" id="counteract-spell" {{#unless actor}}disabled{{/unless}}>
        <option value="">{{localize "COUNTERACT.Dialog.SelectSpell"}}</option>
        {{#if counteractSpells.length}}
          <optgroup label="{{localize "COUNTERACT.Dialog.CounteractSpells"}}">
            {{#each counteractSpells}}
              <option value="{{id}}" {{#if (eq id ../spellId)}}selected{{/if}}>{{name}} ({{localize "COUNTERACT.Dialog.RankN" rank=rank}})</option>
            {{/each}}
          </optgroup>
        {{/if}}
        {{#if otherSpells.length}}
          <optgroup label="{{localize "COUNTERACT.Dialog.OtherSpells"}}">
            {{#each otherSpells}}
              <option value="{{id}}" {{#if (eq id ../spellId)}}selected{{/if}}>{{name}} ({{localize "COUNTERACT.Dialog.RankN" rank=rank}})</option>
            {{/each}}
          </optgroup>
        {{/if}}
      </select>
    </div>

    <div class="pair">
      <div class="form-group stacked">
        <label for="counteract-source-rank">{{localize "COUNTERACT.Dialog.SourceRank"}}</label>
        <select name="sourceRank" id="counteract-source-rank">
          {{#each rankOptions}}<option value="{{this}}" {{#if (eq this ../sourceRank)}}selected{{/if}}>{{this}}</option>{{/each}}
        </select>
      </div>
      <div class="form-group stacked">
        <label for="counteract-modifier">{{localize "COUNTERACT.Dialog.Modifier"}}</label>
        <input type="number" name="modifier" id="counteract-modifier" value="{{modifier}}" step="1">
      </div>
    </div>
  </section>

  {{!-- Target --}}
  <section class="side">
    <header class="side-header">
      {{#if target}}<img src="{{target.img}}" alt="">{{else}}<i class="fa-solid fa-crosshairs" inert></i>{{/if}}
      <h3>
        {{#if target}}
          {{#if isCounterspell}}{{localize "COUNTERACT.Dialog.CasterSection"}}{{else}}{{localize "COUNTERACT.Dialog.TargetSection"}}{{/if}}
          <span class="target-name">{{target.name}}</span>
        {{else}}
          {{localize "COUNTERACT.Dialog.NoTargetSection"}}
        {{/if}}
      </h3>
    </header>

    {{#if target}}
      <div class="form-group">
        <label for="counteract-target-pick">
          {{#if isCounterspell}}{{localize "COUNTERACT.Dialog.SpellBeingCast"}}{{else}}{{localize "COUNTERACT.Dialog.TargetEffect"}}{{/if}}
        </label>
        <select name="targetPick" id="counteract-target-pick">
          <option value="">{{#if isCounterspell}}{{localize "COUNTERACT.Dialog.SelectSpell"}}{{else}}{{localize "COUNTERACT.Dialog.SelectEffect"}}{{/if}}</option>
          {{#if recentSpells.length}}
            <optgroup label="{{localize "COUNTERACT.Dialog.RecentlyCast"}}">
              {{#each recentSpells}}
                <option value="{{id}}" {{#if (eq id ../targetPick)}}selected{{/if}}>{{name}} ({{localize "COUNTERACT.Dialog.RankN" rank=rank}})</option>
              {{/each}}
            </optgroup>
          {{/if}}
          {{#if isCounterspell}}<optgroup label="{{localize "COUNTERACT.Dialog.KnownSpells"}}">{{/if}}
            {{#each targetOptions}}
              <option value="{{id}}" {{#if (eq id ../targetPick)}}selected{{/if}}>{{name}} ({{localize "COUNTERACT.Dialog.RankN" rank=rank}})</option>
            {{/each}}
          {{#if isCounterspell}}</optgroup>{{/if}}
        </select>
      </div>
    {{/if}}

    <div class="form-group">
      <label for="counteract-target-name">{{#if isCounterspell}}{{localize "COUNTERACT.Dialog.SpellName"}}{{else}}{{localize "COUNTERACT.Dialog.TargetName"}}{{/if}}</label>
      <input type="text" name="targetName" id="counteract-target-name" value="{{targetName}}"
             placeholder="{{#if isCounterspell}}{{localize "COUNTERACT.Dialog.SpellNamePlaceholder"}}{{else}}{{localize "COUNTERACT.Dialog.TargetNamePlaceholder"}}{{/if}}">
    </div>

    <div class="pair">
      <div class="form-group stacked">
        <label for="counteract-target-rank">{{#if isCounterspell}}{{localize "COUNTERACT.Dialog.SpellRank"}}{{else}}{{localize "COUNTERACT.Dialog.TargetRank"}}{{/if}}</label>
        <select name="targetRank" id="counteract-target-rank">
          {{#each rankOptions}}<option value="{{this}}" {{#if (eq this ../targetRank)}}selected{{/if}}>{{this}}</option>{{/each}}
        </select>
      </div>
      <div class="form-group stacked">
        <label for="counteract-target-dc">{{localize "COUNTERACT.Dialog.TargetDC"}}</label>
        <input type="number" name="targetDC" id="counteract-target-dc" value="{{targetDC}}" min="1" step="1">
        <p class="hint">{{dcHint}}</p>
      </div>
    </div>
  </section>
</div>
