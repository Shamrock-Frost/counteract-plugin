<div class="counteract-chat-card">
  {{!-- Header --}}
  <div class="card-header">
    <i class="fas fa-ban"></i>
    <span>{{localize "COUNTERACT.ChatCard.Title"}}</span>
  </div>

  {{!-- Roll Details --}}
  <div class="roll-details">
    <div class="detail">
      <span class="detail-label">{{localize "COUNTERACT.ChatCard.Caster"}}</span>
      <span class="detail-value">{{actorName}}</span>
    </div>
    <div class="detail">
      <span class="detail-label">{{localize "COUNTERACT.ChatCard.Spell"}}</span>
      <span class="detail-value">{{spellName}}</span>
    </div>
    <div class="detail">
      <span class="detail-label">{{localize "COUNTERACT.ChatCard.SourceRank"}}</span>
      <span class="detail-value">{{sourceRank}}</span>
    </div>
    <div class="detail">
      <span class="detail-label">{{localize "COUNTERACT.ChatCard.Target"}}</span>
      <span class="detail-value">{{targetName}}</span>
    </div>
  </div>

  {{!-- Roll Display --}}
  <div class="roll-display">
    <div class="roll-formula">
      <span class="die-result" title="{{localize "COUNTERACT.ChatCard.DieResult"}}">{{dieResult}}</span>
      + <span class="modifier" title="{{localize "COUNTERACT.ChatCard.Modifier"}}">{{modifier}}</span>
      = <span class="total" title="{{localize "COUNTERACT.ChatCard.Total"}}">{{roll}}</span>
    </div>
    <div class="roll-vs">
      {{localize "COUNTERACT.ChatCard.Versus"}} DC {{targetDC}}
    </div>
  </div>

  {{!-- Degree of Success --}}
  <div class="degree-of-success {{degreeOfSuccess}}">
    {{degreeLabel}}
  </div>

  {{!-- Rank Comparison --}}
  <div class="rank-comparison">
    <span>{{localize "COUNTERACT.ChatCard.SourceRank"}}: {{sourceRank}}</span>
    <span>|</span>
    <span>{{localize "COUNTERACT.ChatCard.TargetRank"}}: {{targetRank}}</span>
    {{#if threshold}}
    <span>|</span>
    <span>{{localize "COUNTERACT.ChatCard.Threshold"}}: {{threshold}}</span>
    {{/if}}
  </div>

  {{!-- Result Banner --}}
  <div class="result-banner {{#if success}}success{{else}}failure{{/if}}">
    {{resultLabel}}
  </div>
</div>
