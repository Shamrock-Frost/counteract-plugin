<div class="counteract-chat-card">
  <header class="card-header">
    <img src="{{spellImg}}" alt="">
    <div class="titles">
      <h3>{{spellName}}</h3>
      <span class="subtitle">
        {{#if isCounterspell}}{{localize "COUNTERACT.ModeSelect.Counterspell"}}{{else}}{{localize "COUNTERACT.ChatCard.Title"}}{{/if}}
        · {{localize "COUNTERACT.Dialog.RankN" rank=sourceRank}}
      </span>
    </div>
  </header>

  <div class="versus">
    {{#if targetImg}}<img src="{{targetImg}}" alt="">{{else}}<i class="fa-solid fa-crosshairs" inert></i>{{/if}}
    <span class="target-name">{{targetName}}</span>
    <span class="tag">{{localize "COUNTERACT.Dialog.RankN" rank=targetRank}}</span>
    <span class="tag">{{localize "COUNTERACT.ChatCard.DC" dc=targetDC}}</span>
  </div>

  <div class="roll-line">
    <span class="die {{isNat}}" data-tooltip="{{localize "COUNTERACT.ChatCard.DieResult"}}">{{dieResult}}</span>
    <span class="modifier">{{modifierLabel}}</span>
    <span class="equals">=</span>
    <span class="total">{{total}}</span>
    <span class="degree {{degreeOfSuccess}}">{{degreeLabel}}</span>
  </div>

  <div class="result {{#if success}}success{{else}}failure{{/if}}">
    <strong>
      <i class="fa-solid {{#if success}}fa-circle-check{{else}}fa-circle-xmark{{/if}}" inert></i>
      {{resultLabel}}
    </strong>
    <span class="explanation">{{explanation}}</span>
  </div>

  {{#if canRemove}}
    <button type="button" data-counteract-remove>
      <i class="fa-solid fa-eraser" inert></i> {{localize "COUNTERACT.ChatCard.RemoveEffect" name=targetName}}
    </button>
  {{/if}}
</div>
